{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pemira-pmk-itera",
	"compatibility_date": "2026-11-09",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	// Database D1 production. ID database bukan rahasia.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pemira-db",
			"database_id": "d461eca2-b900-4ddb-bd87-e62e63375dde",
			"migrations_dir": "migrations"
		}
	],
	"env": {
		// Lingkungan simulasi/uji coba, terpisah total dari production:
		// `wrangler deploy --env staging`, `wrangler d1 ... --env staging`.
		"staging": {
			"name": "pemira-pmk-itera-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "pemira-db-staging",
					"database_id": "5a2eeacc-5ce5-46e3-9c9b-cf18876c7336",
					"migrations_dir": "migrations"
				}
			]
		}
	}
	// Secret (TIDAK disimpan di repo), diatur dengan `wrangler secret put <NAMA>`:
	//   ADMIN_EMAILS  daftar email admin dipisah koma
	// Untuk pengembangan lokal, salin `.dev.vars.example` menjadi `.dev.vars`.
}
