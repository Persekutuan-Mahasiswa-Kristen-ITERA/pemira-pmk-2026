{
	// Cloudflare Pages (bukan Workers): Pages mendukung custom subdomain lewat
	// CNAME di DNS luar (Rumahweb), tanpa harus memindahkan nameserver.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pemira-pmk-itera",
	"compatibility_date": "2026-11-09",
	"compatibility_flags": ["nodejs_als"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	// Production (branch `main`). ID database bukan rahasia.
	// APP_ENV ditampilkan di situs (pita "uji coba" dan footer), dan selalu didefinisikan di blok
	// yang sama dengan database-nya supaya label dan database yang dipakai tidak mungkin berbeda.
	"vars": { "APP_ENV": "production" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pemira-db",
			"database_id": "d461eca2-b900-4ddb-bd87-e62e63375dde",
			"migrations_dir": "migrations"
		}
	],
	"env": {
		// Preview (semua branch selain `main`, termasuk `staging`): untuk simulasi/uji coba,
		// memakai database terpisah dari production.
		"preview": {
			"vars": { "APP_ENV": "staging" },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "pemira-db-staging",
					"database_id": "5a2eeacc-5ce5-46e3-9c9b-cf18876c7336",
					"migrations_dir": "migrations",
					// Hanya untuk `pnpm dev` mode "live remote": server lokal memakai database
					// staging di Cloudflare (perlu `wrangler login`). Tidak memengaruhi deploy.
					"remote": true
				}
			]
		}
	}
	// Secret (TIDAK disimpan di repo):
	//   SUPER_ADMIN_EMAILS  email super admin dipisah koma (admin lain diundang lewat /admin/panitia)
	//   pnpm wrangler pages secret put SUPER_ADMIN_EMAILS                 (production)
	//   pnpm wrangler pages secret put SUPER_ADMIN_EMAILS --env preview   (staging)
	// Untuk pengembangan lokal, salin `.dev.vars.example` menjadi `.dev.vars`.
}
