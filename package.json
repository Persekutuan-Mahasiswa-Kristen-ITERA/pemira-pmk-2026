{
	"name": "pemira-pmk-itera",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "wrangler types --env-file .dev.vars.example && vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --env-file .dev.vars.example && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"gen": "wrangler types --env-file .dev.vars.example",
		"db:migrate:local": "wrangler d1 migrations apply pemira-db --local",
		"db:reset:local": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply pemira-db --local",
		"db:seed:local": "wrangler d1 execute pemira-db --local --file scripts/seed-dev.sql",
		"db:seed:demo": "wrangler d1 execute pemira-db --local --file scripts/seed-demo.sql",
		"db:seed:panitia:local": "wrangler d1 execute pemira-db --local --file scripts/seed-dev-panitia.sql",
		"db:demo:local": "wrangler d1 execute pemira-db --local --file scripts/drop-all.sql && wrangler d1 migrations apply pemira-db --local && pnpm db:seed:panitia:local && wrangler d1 execute pemira-db --local --file scripts/seed-dev-simulasi.sql",
		"db:reset:uji-coba": "node scripts/reset-uji-coba.mjs",
		"db:reset:staging": "wrangler d1 execute pemira-db-staging --env preview --remote --file scripts/drop-all.sql && wrangler d1 migrations apply pemira-db-staging --env preview --remote",
		"deploy:staging": "pnpm build && wrangler pages deploy --branch staging"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@fontsource-variable/nunito-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"engines": {
		"node": ">=22.13"
	},
	"dependencies": {
		"firebase": "^13.2.0",
		"jose": "^6.2.15"
	},
	"packageManager": "pnpm@11.5.1"
}
